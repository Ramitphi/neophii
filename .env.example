# Server (Vertex AI via Cloud Run ADC / gcloud auth application-default login)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
MEDIA_BUCKET=your-project-id-neophi-media
ANALYSIS_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-2
PORT=8080

# Frontend Firebase Web Config (public, not a secret). For the production build put these four lines in
# .env.production (gitignored); scripts/deploy/10-firebase.sh writes it and 20-build.sh passes them as build args.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Instagram DM pipeline (names only; secrets come from Secret Manager, never this file)
# Secrets: META_APP_SECRET, META_VERIFY_TOKEN, INSTAGRAM_ACCESS_TOKEN (optional), INSTAGRAM_WORKER_SECRET (optional)
META_IG_RECIPIENT_ID=
INSTAGRAM_SENDER_UID_MAP=
# Username of the connected account, no @. Shown on the site for self-serve linking (docs/INSTAGRAM_LINKING.md).
INSTAGRAM_HANDLE=
# 1 lets any signed-in person send a simulated share into their own library (docs/INSTAGRAM_LINKING.md). Off by default.
INSTAGRAM_DEMO_SENDER=
META_GRAPH_VERSION=v27.0
META_GRAPH_HOST=graph.instagram.com
INSTAGRAM_MEDIA_HOSTS=
INSTAGRAM_WORKER_OIDC_AUDIENCE=
INSTAGRAM_WORKER_SERVICE_ACCOUNT=
INSTAGRAM_WORKER_POLL_MS=0
INSTAGRAM_LOG_DENIED_SENDERS=0
